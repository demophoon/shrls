FROM ghcr.io/demophoon/shrls:0.2.2 as shrls

FROM scratch

COPY --from=shrls /shrls /app/shrls
COPY --from=shrls /tmp /tmp
COPY --from=shrls /etc/ssl/certs /etc/ssl/certs

COPY ./demo.yaml /app/config.yaml

ENV SHRLS_EXPERIMENTAL=true

ENTRYPOINT ["/app/shrls"]
CMD ["serve", "--demo", "--config", "/app/config.yaml"]

EXPOSE 8000
